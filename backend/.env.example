# ── Application ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5100,http://127.0.0.1:5100,http://localhost:5173,http://127.0.0.1:5173
MAX_PAGE_SIZE=100

# ── Transport hardening ───────────────────────────────────────
# Comma-separated hostnames this API answers for. "*" disables the check; set
# the real domains in production (rmdumobiles.com,www.rmdumobiles.com).
ALLOWED_HOSTS=*
# Only these peers may set X-Forwarded-For. Leave empty unless a reverse proxy
# or load balancer sits in front of the app, otherwise the header is ignored.
TRUSTED_PROXIES=
# Request bodies above this many bytes are refused with 413 before parsing.
MAX_REQUEST_BYTES=1000000
SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
# Interactive docs (/docs, /redoc) default to off when APP_ENV=production.
ENABLE_DOCS=

# ── Supabase (server-side credentials only, never shipped to the browser) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-secret-service-key

# ── Data-plane write lock ─────────────────────────────────────
# true = serve reads, refuse every write (INSERT/UPDATE/DELETE/RPC) before it
# leaves the process, and make scripts/apply_sql.py refuse a migration. The API
# answers 503 database_locked and nothing in the database changes.
DB_READ_ONLY=false

# ── Admin surface (required to enable /api/v1/admin/*) ────────
ADMIN_API_KEY=change-me-to-a-long-random-string
# Optional IP/CIDR allowlist for the admin surface (empty = any address).
ADMIN_IP_ALLOWLIST=
# Failed admin keys per address before that address is locked out.
ADMIN_MAX_FAILED_ATTEMPTS=10
ADMIN_LOCKOUT_SECONDS=900

# ── AI / RAG (optional; endpoints degrade to keyword mode when absent) ──
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
