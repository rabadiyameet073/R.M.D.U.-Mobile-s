# RMDU Mobiles — Frontend Environment Configuration Template
# Duplicate this file as '.env' inside the frontend/ folder.

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI Backend Service Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment Mode
VITE_APP_ENV=development
