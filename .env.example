# =============================================================================
# RMDU MOBILES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as '.env' and populate with your real project credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE & DATABASE CONFIGURATION (PostgreSQL 15+)
# -----------------------------------------------------------------------------
# Retrieve these from your Supabase Dashboard -> Project Settings -> Database / API

# Direct PostgreSQL Connection URL (Used for schema migrations, psql, and backend ORM)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Connection Pooling URL (Recommended for high-concurrency serverless / FastAPI asyncpg)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_POOLED_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe to expose to client/frontend browsers)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Secret Key (BACKEND ONLY — Never expose in client code. Bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# -----------------------------------------------------------------------------
# 2. FASTAPI BACKEND SERVER SETTINGS
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Allowed CORS Origins (comma-separated list for Vite frontend clients)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security / Authentication Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=generate-a-secure-random-32-byte-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Data-plane write lock. true = the API serves reads but refuses every write
# (INSERT/UPDATE/DELETE/RPC) before it leaves the process, and
# scripts/apply_sql.py refuses to run a migration. Use it while the database is
# locked for maintenance or review. Responses become 503 database_locked.
DB_READ_ONLY=false

# -----------------------------------------------------------------------------
# 3. AI & RAG VECTOR SEARCH (pgvector / Embeddings)
# -----------------------------------------------------------------------------
# OpenAI API Key for generating 1536-dimensional device embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional: Google Gemini API Key (if using Gemini for conversational inference)
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# 4. FRONTEND (Vite / React) CLIENT-SIDE VARIABLES
# -----------------------------------------------------------------------------
# In Vite, variables prefixed with 'VITE_' are bundled and accessible via 'import.meta.env'
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development
